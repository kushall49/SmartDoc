// Prisma schema for SmartDocIQ
// Single source of truth for PostgreSQL + pgvector

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         String      @default("user")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  documents    Document[]
  chunks       Chunk[]
  chats        Chat[]
  usageLogs    UsageLog[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Document {
  id                    String      @id @default(uuid()) @db.Uuid
  userId                String      @map("user_id") @db.Uuid
  name                  String
  originalName          String      @map("original_name")
  mimeType              String      @map("mime_type")
  sizeBytes             Int         @default(0) @map("size_bytes")
  filePath              String      @map("file_path")
  status                String      @default("pending") // uploading | pending | processing | ready | failed
  documentType          String?     @map("document_type") // invoice | contract | resume | report | image | legal | other
  pageCount             Int?        @map("page_count")
  rawText               String?     @map("raw_text") @db.Text
  summary               String?     @db.Text
  entities              Json        @default("[]")
  keywords              String[]    @default([])
  anomalies             String[]    @default([])
  aiProvider            String?     @map("ai_provider")
  tokensUsed            Int         @default(0) @map("tokens_used")
  processingStartedAt   DateTime?   @map("processing_started_at")
  processingCompletedAt DateTime?   @map("processing_completed_at")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks                Chunk[]
  chats                 Chat[]
  usageLogs             UsageLog[]

  @@index([userId])
  @@index([status])
  @@map("documents")
}

model Chunk {
  id          String                       @id @default(uuid()) @db.Uuid
  documentId  String                       @map("document_id") @db.Uuid
  userId      String                       @map("user_id") @db.Uuid
  chunkIndex  Int                          @map("chunk_index")
  chunkText   String                       @map("chunk_text") @db.Text
  chunkTokens Int                          @default(0) @map("chunk_tokens")
  pageNumber  Int?                         @map("page_number")
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime                     @default(now()) @map("created_at")

  document    Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId, chunkIndex])
  @@index([userId])
  @@map("chunks")
}

model Chat {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  documentId      String      @map("document_id") @db.Uuid
  title           String      @default("New Chat")
  totalTokensUsed Int         @default(0) @map("total_tokens_used")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  document        Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@index([userId, documentId])
  @@map("chats")
}

model Message {
  id         String   @id @default(uuid()) @db.Uuid
  chatId     String   @map("chat_id") @db.Uuid
  role       String   // "user" | "assistant"
  content    String   @db.Text
  sources    Json     @default("[]")
  tokensUsed Int      @default(0) @map("tokens_used")
  provider   String?
  model      String?
  createdAt  DateTime @default(now()) @map("created_at")

  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@map("messages")
}

model UsageLog {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  documentId       String?   @map("document_id") @db.Uuid
  action           String
  provider         String
  model            String
  inputTokens      Int       @default(0) @map("input_tokens")
  outputTokens     Int       @default(0) @map("output_tokens")
  totalTokens      Int       @default(0) @map("total_tokens")
  estimatedCostUsd Float     @default(0) @map("estimated_cost_usd")
  durationMs       Int       @default(0) @map("duration_ms")
  success          Boolean   @default(true)
  errorMessage     String?   @map("error_message") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document         Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("usage_logs")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  action       String
  resourceId   String?  @map("resource_id")
  resourceType String?  @map("resource_type")
  metadata     Json     @default("{}")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  success      Boolean  @default(true)
  error        String?  @db.Text
  duration     Int?
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

