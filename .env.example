# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/smartdociq

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET_NAME=smartdociq-documents

# OpenAI - Updated to latest models (2026)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o                          # Upgrade from gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-large # Upgrade from text-embedding-3-small
OPENAI_FALLBACK_MODEL=gpt-4o-mini            # For simple tasks (cost optimization)
GROQ_API_KEY=your_groq_api_key               # Optional fallback LLM provider

# Anthropic Claude - For advanced document analysis
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022   # Best for document understanding

# Redis (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_generate_with_openssl

# AWS Textract (Optional - if using instead of Tesseract)
USE_AWS_TEXTRACT=false

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Document Processing
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg,docx

# TestSpirit AI Debugging
TESTSPIRIT_API_KEY=your_testspirit_api_key
