# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/smartdociq

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET_NAME=smartdociq-documents

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Redis (BullMQ) ────────────────────────────────────────────────────────────
# Option A: hosted Redis URL (Upstash etc.) — overrides host/port/password below
# REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# Option B: local / Docker Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Set to true only when running the dedicated worker process (npm run worker)
# USE_DOCUMENT_QUEUE=true

# ── Auth (NextAuth) ───────────────────────────────────────────────────────────
# Production: NEXTAUTH_URL must match your deployment URL exactly (no trailing slash)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_generate_with_openssl_rand_base64_32

# ── OCR ───────────────────────────────────────────────────────────────────────
# Set to true to use AWS Textract instead of Tesseract.js (requires AWS credentials)
USE_AWS_TEXTRACT=false

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ── Document Processing ───────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg,docx
